# Chiave API di Google Gemini: https://aistudio.google.com/apikey
# Obbligatoria. Non committare mai il file .env.
GEMINI_API_KEY=

# Modello per il testo della storia. Lista separata da virgole:
# i modelli vengono provati in ordine (fallback automatico se uno non è
# disponibile o è sovraccarico).
GEMINI_TEXT_MODEL=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite

# Modello TTS, stessa logica di fallback in ordine di preferenza.
# Verifica i nomi disponibili con:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models" \
#     -H "x-goog-api-key: $GEMINI_API_KEY" | grep -i tts
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts

# Voce per la lettura. Voci calde/dolci consigliate:
# Sulafat (calda), Aoede (leggera), Leda (giovane), Achernar (morbida), Vindemiatrix (gentile)
GEMINI_TTS_VOICE=Sulafat

# Lingua della sintesi vocale.
GEMINI_TTS_LANGUAGE=it-IT

# Dimensione massima (caratteri) dei blocchi audio: primo, secondo, poi
# l'ultimo valore si ripete. Un primo blocco piccolo fa partire la
# riproduzione in fretta; blocchi grandi riducono il numero di chiamate.
# TTS_CHUNK_PLAN=300,600,1200

# Quante sintesi TTS eseguire in parallelo. Il piano gratuito consente solo
# 3 richieste al minuto per modello TTS: lascia 1 (i capitoli si generano in
# sequenza senza toccare il limite); alza a 2-3 solo con fatturazione attiva.
# TTS_CONCURRENCY=2

# Cartella dove vengono salvate storie e audio generati (cache locale).
# STORIES_DIR=data/stories
