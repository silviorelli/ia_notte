{
  "openapi": "3.1.0",
  "info": {
    "title": "IA notte",
    "version": "0.2.0"
  },
  "paths": {
    "/api/config": {
      "get": {
        "summary": "Get Config",
        "description": "Return frontend configuration: preset characters and default speed.",
        "operationId": "get_config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Config Api Config Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/stories": {
      "get": {
        "summary": "List Stories",
        "description": "List the most recently generated stories, newest first.",
        "operationId": "list_stories_api_stories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Stories Api Stories Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Story",
        "description": "Generate a story and start its narration in the background.\n\nReturns as soon as the story text is ready; audio chunks are synthesized\nconcurrently by a background task and exposed via the record's\n``chunks_ready`` counter and the part audio endpoint.\n\nRaises:\n    HTTPException: 503 if the API key is missing, 502 if generation fails.",
        "operationId": "create_story_api_stories_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Create Story Api Stories Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stories/{story_id}": {
      "get": {
        "summary": "Get Story",
        "description": "Return a cached story record.\n\nWhile narration is in progress the response also carries a\n``rate_limited`` flag so the frontend can explain slowdowns caused by\nAPI quota throttling.\n\nRaises:\n    HTTPException: 404 if the story does not exist.",
        "operationId": "get_story_api_stories__story_id__get",
        "parameters": [
          {
            "name": "story_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Story Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Story Api Stories  Story Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stories/{story_id}/audio": {
      "get": {
        "summary": "Get Story Audio",
        "description": "Stream the complete WAV narration of a cached story.\n\nRaises:\n    HTTPException: 404 if the audio does not exist (yet).",
        "operationId": "get_story_audio_api_stories__story_id__audio_get",
        "parameters": [
          {
            "name": "story_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Story Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stories/{story_id}/audio/{part}": {
      "get": {
        "summary": "Get Story Audio Part",
        "description": "Stream one narration chunk of a story being generated.\n\nRaises:\n    HTTPException: 404 if the part does not exist (yet).",
        "operationId": "get_story_audio_part_api_stories__story_id__audio__part__get",
        "parameters": [
          {
            "name": "story_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Story Id"
            }
          },
          {
            "name": "part",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Part"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StoryRequest": {
        "properties": {
          "character": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Character"
          }
        },
        "type": "object",
        "required": [
          "character"
        ],
        "title": "StoryRequest",
        "description": "Request body for story creation."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
